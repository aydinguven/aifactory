ARG PYTHON_IMAGE=registry.access.redhat.com/ubi10/python-312-minimal:latest
FROM ${PYTHON_IMAGE}

ARG AIFACTORY_VERSION=0.0.0
LABEL org.opencontainers.image.title="AI Factory Worker" \
      org.opencontainers.image.description="AI Factory rootful Podman workspace worker" \
      org.opencontainers.image.version="${AIFACTORY_VERSION}"

USER 0
WORKDIR /opt/aifactory

RUN microdnf install -y podman tar gzip && microdnf clean all

COPY requirements.txt /opt/aifactory/requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
        -r /opt/aifactory/requirements.txt

COPY app /opt/aifactory/app
COPY deploy /opt/aifactory/deploy
RUN chmod 0755 /opt/aifactory/deploy/container/worker-entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CONTAINER_HOST=unix:///run/podman/podman.sock \
    STORAGE_ROOT=/var/lib/aifactory/workspaces \
    HOME=/root

ENTRYPOINT ["/opt/aifactory/deploy/container/worker-entrypoint.sh"]
