diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
new file mode 100644
index 0000000..d761e5e
--- /dev/null
+++ b/.github/workflows/tests.yml
@@ -0,0 +1,69 @@
+name: Tests
+
+# Runs on every pull request and on pushes to main, so breakage shows up
+# before a release tag. Read-only: no secrets, no publishing.
+on:
+  pull_request:
+    paths-ignore:
+      - "**.md"
+  push:
+    branches: [main]
+    paths-ignore:
+      - "**.md"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: tests-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  tests:
+    name: Test suite and static checks
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    # Same PostgreSQL service as the release workflow's test job, so the
+    # PostgreSQL-only tests run here too.
+    services:
+      postgres:
+        image: postgres:16
+        env:
+          POSTGRES_USER: aifactory
+          POSTGRES_PASSWORD: aifactory
+          POSTGRES_DB: aifactory_test
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U aifactory -d aifactory_test"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+    env:
+      TEST_POSTGRES_URL: postgresql+asyncpg://aifactory:aifactory@127.0.0.1:5432/aifactory_test
+      TEST_POSTGRESQL_URL: postgresql+asyncpg://aifactory:aifactory@127.0.0.1:5432/aifactory_test
+      MLFLOW_DISABLE_AGENT_HINT: "1"
+    steps:
+      - name: Check out source
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+
+      - name: Install dependencies
+        run: python -m pip install --disable-pip-version-check -r requirements.txt ruff==0.17.5
+
+      - name: Ruff (syntax errors and undefined names)
+        run: ruff check --select E9,F63,F7,F82 .
+
+      - name: ShellCheck (errors only)
+        run: find deploy containers -name '*.sh' -print0 | sort -z | xargs -0 shellcheck -S error
+
+      - name: JavaScript syntax
+        run: for f in app/static/js/*.js; do node --check "$f"; done
+
+      - name: Run test suite
+        run: python -m pytest -q
