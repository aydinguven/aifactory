+def person(team="", unit="", groups=(), role=UserRole.USER):
+    return SimpleNamespace(
+        team=team,
+        organization_unit=unit,
+        directory_groups=json.dumps(list(groups)),
+        role=role,
+    )
+
+
+def rule(allow="", deny=""):
+    return AccessRule(allow=parse_entries(allow), deny=parse_entries(deny))
