diff --git a/containers/browser-chromium/Containerfile b/containers/browser-chromium/Containerfile
new file mode 100644
index 0000000..173e227
--- /dev/null
+++ b/containers/browser-chromium/Containerfile
@@ -0,0 +1,67 @@
+# Tarayıcı (Chromium)
+# A Chromium window delivered to the browser, for sites that are reachable from
+# the worker but not from user desktops (Claude, ChatGPT and similar). TigerVNC
+# (Xvnc) is the display, websockify serves the noVNC client and the WebSocket
+# on one port, which is the shape the AI Factory proxy tunnels. AI Factory is
+# the only authenticator, so the VNC server has no password of its own and
+# listens on a Unix socket that only websockify reaches.
+#
+# Debian rather than Rocky: Rocky Linux 10 ships neither an X server nor a VNC
+# server. This is the same family the code-server images are built on.
+ARG BASE_IMAGE=docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
+FROM ${BASE_IMAGE}
+
+USER root
+
+# Chromium comes from Debian security updates, so a rebuild is what picks up
+# browser fixes. The fonts cover Latin/Turkish and CJK text, code blocks and emoji.
+RUN apt-get update \
+    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+        ca-certificates \
+        chromium \
+        chromium-l10n \
+        fonts-dejavu-core \
+        fonts-liberation \
+        fonts-noto-cjk \
+        fonts-noto-color-emoji \
+        fonts-noto-core \
+        libnss3-tools \
+        novnc \
+        openbox \
+        tigervnc-standalone-server \
+        tzdata \
+        websockify \
+        x11-xserver-utils \
+    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
+
+RUN useradd --create-home --uid 1000 --shell /bin/bash browser
+
+# The client page is AI Factory's own; only noVNC's RFB library is reused.
+COPY index.html /opt/aifactory-browser/web/index.html
+RUN ln -s /usr/share/novnc/core /opt/aifactory-browser/web/core \
+    && ln -s /usr/share/novnc/vendor /opt/aifactory-browser/web/vendor \
+    && test -r /opt/aifactory-browser/web/core/rfb.js
+
+# Managed policies are root-owned, so a workspace user cannot change them.
+COPY policies/managed.json /etc/chromium/policies/managed/aifactory.json
+COPY policies/recommended.json /etc/chromium/policies/recommended/aifactory.json
+COPY openbox-rc.xml /etc/xdg/openbox/rc.xml
+COPY entrypoint.sh /usr/local/bin/aifactory-browser-entrypoint
+RUN chmod 0644 /opt/aifactory-browser/web/index.html \
+        /etc/chromium/policies/managed/aifactory.json \
+        /etc/chromium/policies/recommended/aifactory.json \
+        /etc/xdg/openbox/rc.xml \
+    && chmod 0755 /usr/local/bin/aifactory-browser-entrypoint
+
+ENV HOME=/home/browser \
+    LANG=C.UTF-8 \
+    LC_ALL=C.UTF-8 \
+    LANGUAGE=tr \
+    AIFACTORY_BROWSER_PORT=6080
+
+USER browser
+WORKDIR /home/browser
+
+EXPOSE 6080
+
+ENTRYPOINT ["/usr/local/bin/aifactory-browser-entrypoint"]
diff --git a/containers/browser-chromium/entrypoint.sh b/containers/browser-chromium/entrypoint.sh
new file mode 100755
index 0000000..57c7647
--- /dev/null
+++ b/containers/browser-chromium/entrypoint.sh
@@ -0,0 +1,178 @@
+#!/usr/bin/env bash
+# Start the display, the window manager, Chromium and the noVNC bridge.
+set -euo pipefail
+
+HOME_DIR="${HOME:-/home/browser}"
+PORT="${AIFACTORY_BROWSER_PORT:-6080}"
+WEB_ROOT="/opt/aifactory-browser/web"
+RUNTIME_DIR="/tmp/aifactory-browser"
+VNC_SOCKET="${RUNTIME_DIR}/vnc.sock"
+PROFILE_DIR="${HOME_DIR}/.config/chromium"
+NSS_DB="sql:${HOME_DIR}/.pki/nssdb"
+CA_NICKNAME_PREFIX="AI Factory CA"
+export DISPLAY=":1"
+
+# A stopped container keeps its /tmp. Stale X locks and sockets from the
+# previous run would stop Xvnc from claiming the display again.
+rm -rf "${RUNTIME_DIR}" /tmp/.X1-lock /tmp/.X11-unix/X1
+install -d -m 700 "${RUNTIME_DIR}"
+mkdir -p "${HOME_DIR}/Downloads" "${PROFILE_DIR}"
+cd "${HOME_DIR}"
+
+# The profile lives on the persistent volume. A container that was killed
+# leaves Chromium's singleton lock behind, pointing at a hostname that no
+# longer exists, and the next start would refuse to open the profile.
+rm -f "${PROFILE_DIR}"/Singleton{Lock,Socket,Cookie}
+
+# Chromium on Linux trusts the roots in the user's NSS database on top of its
+# built-in store. The Admin CA bundle (a TLS-inspecting corporate proxy, for
+# example) is imported on every start, and certificates removed from the
+# bundle are removed here too.
+sync_ca_bundle() {
+    install -d -m 700 "${HOME_DIR}/.pki/nssdb"
+    if ! certutil -d "${NSS_DB}" -L >/dev/null 2>&1; then
+        certutil -d "${NSS_DB}" -N --empty-password
+    fi
+    certutil -d "${NSS_DB}" -L 2>/dev/null \
+        | sed -n "s/^\(${CA_NICKNAME_PREFIX} [0-9]*\) .*$/\1/p" \
+        | while IFS= read -r nickname; do
+            certutil -d "${NSS_DB}" -D -n "${nickname}" || true
+        done
+    [[ -n "${AIFACTORY_CA_BUNDLE_PEM:-}" ]] || return 0
+    local split_dir="${RUNTIME_DIR}/ca"
+    rm -rf "${split_dir}"
+    install -d -m 700 "${split_dir}"
+    printf '%s\n' "${AIFACTORY_CA_BUNDLE_PEM}" | awk -v dir="${split_dir}" '
+        /-----BEGIN CERTIFICATE-----/ { count += 1; writing = 1 }
+        writing { print > (dir "/" count ".pem") }
+        /-----END CERTIFICATE-----/ { writing = 0; close(dir "/" count ".pem") }
+    '
+    local index=0 certificate
+    for certificate in "${split_dir}"/*.pem; do
+        [[ -e "${certificate}" ]] || continue
+        index=$((index + 1))
+        certutil -d "${NSS_DB}" -A -t "C,," \
+            -n "${CA_NICKNAME_PREFIX} ${index}" -i "${certificate}" \
+            || echo "aifactory-browser: CA certificate ${index} was not imported" >&2
+    done
+    echo "aifactory-browser: ${index} CA certificate(s) trusted"
+}
+sync_ca_bundle
+unset AIFACTORY_CA_BUNDLE_PEM
+
+# Clipboard direction between the user's machine and the workspace:
+# both (default), in (paste into the workspace only), out (copy out only), none.
+accept_clipboard=1
+send_clipboard=1
+case "${AIFACTORY_BROWSER_CLIPBOARD:-both}" in
+    in) send_clipboard=0 ;;
+    out) accept_clipboard=0 ;;
+    none) accept_clipboard=0; send_clipboard=0 ;;
+esac
+
+children=()
+chromium_pid=""
+shutdown() {
+    trap - TERM INT
+    # Chromium first, with time to flush cookies and the open tabs to the
+    # profile; Podman sends SIGKILL ten seconds after SIGTERM.
+    if [[ -n "${chromium_pid}" ]]; then
+        kill -TERM "${chromium_pid}" 2>/dev/null || true
+        ( sleep 7; kill -KILL "${chromium_pid}" 2>/dev/null ) &
+        wait "${chromium_pid}" 2>/dev/null || true
+    fi
+    echo "aifactory-browser: stopped"
+    kill "${children[@]}" 2>/dev/null || true
+    exit 0
+}
+trap shutdown TERM INT
+
+# No TCP listener: the socket is the only way in, and websockify is the only
+# process that uses it.
+Xvnc "${DISPLAY}" \
+    -geometry "${AIFACTORY_BROWSER_GEOMETRY:-1600x900}" \
+    -depth 24 \
+    -SecurityTypes None \
+    -rfbunixpath "${VNC_SOCKET}" \
+    -rfbunixmode 0600 \
+    -rfbport -1 \
+    -AlwaysShared \
+    -AcceptCutText="${accept_clipboard}" \
+    -SendCutText="${send_clipboard}" \
+    -SendPrimary=0 \
+    -SetPrimary=0 \
+    -desktop "AI Factory" \
+    -nolisten tcp &
+children+=("$!")
+xvnc_pid="$!"
+
+for _ in $(seq 1 100); do
+    [[ -S "${VNC_SOCKET}" ]] && break
+    sleep 0.1
+done
+[[ -S "${VNC_SOCKET}" ]] || { echo "aifactory-browser: Xvnc did not start" >&2; exit 1; }
+
+openbox &
+children+=("$!")
+
+websockify --web "${WEB_ROOT}" --heartbeat 30 \
+    --unix-target "${VNC_SOCKET}" "0.0.0.0:${PORT}" &
+children+=("$!")
+websockify_pid="$!"
+
+# The sites open on the very first start only; afterwards Chromium restores the
+# previous session.
+first_run_urls=()
+if [[ ! -e "${PROFILE_DIR}/Local State" ]]; then
+    # `custom_chrome_frame: false` drops Chromium's own minimize/maximize/close
+    # buttons: the browser is the whole desktop, so a minimized window could
+    # not be brought back. (--no-first-run skips /etc/chromium/master_preferences,
+    # hence the seeded profile.)
+    if [[ ! -e "${PROFILE_DIR}/Default/Preferences" ]]; then
+        mkdir -p "${PROFILE_DIR}/Default"
+        printf '%s\n' '{"browser":{"custom_chrome_frame":false}}' \
+            > "${PROFILE_DIR}/Default/Preferences"
+    fi
+    read -r -a first_run_urls <<< "${AIFACTORY_BROWSER_START_URLS:-https://claude.ai/ https://chatgpt.com/}"
+fi
+
+# --no-sandbox: rootless Podman's default seccomp profile does not let Chromium
+# create its sandbox namespaces. The container (non-root, no sudo, one per
+# user) is the isolation boundary.
+# --disable-dev-shm-usage: the container's /dev/shm is 64 MB.
+# --password-store=basic: there is no keyring daemon to unlock.
+# --log-level=3: without a D-Bus session Chromium logs an error every few
+# seconds, which would bury everything else in the workspace log.
+run_chromium() {
+    chromium \
+        --no-sandbox \
+        --disable-dev-shm-usage \
+        --disable-gpu \
+        --no-first-run \
+        --no-default-browser-check \
+        --password-store=basic \
+        --hide-crash-restore-bubble \
+        --log-level=3 \
+        --start-maximized \
+        --window-position=0,0 \
+        --user-data-dir="${PROFILE_DIR}" \
+        "$@" &
+    chromium_pid="$!"
+}
+
+run_chromium "${first_run_urls[@]}"
+# Closing the last window ends Chromium; open it again rather than leaving the
+# user with an empty screen. The container stops when the display or the
+# bridge dies, and Podman's restart policy brings it back.
+while kill -0 "${xvnc_pid}" 2>/dev/null && kill -0 "${websockify_pid}" 2>/dev/null; do
+    if ! kill -0 "${chromium_pid}" 2>/dev/null; then
+        wait "${chromium_pid}" 2>/dev/null || true
+        sleep 1
+        rm -f "${PROFILE_DIR}"/Singleton{Lock,Socket,Cookie}
+        run_chromium
+    fi
+    sleep 1
+done
+echo "aifactory-browser: display or WebSocket bridge exited" >&2
+kill "${children[@]}" "${chromium_pid}" 2>/dev/null || true
+exit 1
diff --git a/containers/browser-chromium/index.html b/containers/browser-chromium/index.html
new file mode 100644
index 0000000..5f50005
--- /dev/null
+++ b/containers/browser-chromium/index.html
@@ -0,0 +1,219 @@
+<!DOCTYPE html>
+<html lang="tr">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Tarayıcı - AI Factory</title>
+<style>
+  :root { color-scheme: dark; font-family: "Segoe UI", Arial, sans-serif; }
+  * { box-sizing: border-box; }
+  html, body { height: 100%; margin: 0; background: #1b1f27; color: #e6ecf5; overflow: hidden; }
+  #screen { position: fixed; inset: 0; }
+  #status {
+    position: fixed; inset: 0; display: flex; flex-direction: column;
+    align-items: center; justify-content: center; gap: 14px;
+    background: rgba(27, 31, 39, 0.92); text-align: center; padding: 24px; z-index: 5;
+  }
+  #status[hidden] { display: none; }
+  #status-text { font-size: 17px; }
+  #status-detail { font-size: 13px; color: #9aa7ba; max-width: 46ch; }
+  /* On the left edge, clear of the remote browser's tabs and scrollbar. */
+  #bar {
+    position: fixed; left: 0; top: 50%; transform: translateY(-50%); z-index: 10;
+    display: flex; align-items: center;
+  }
+  #bar-toggle {
+    width: 10px; height: 64px; border: 0; padding: 0; cursor: pointer;
+    border-radius: 0 8px 8px 0; background: #d50032; opacity: 0.55;
+  }
+  #bar-toggle:hover, #bar-toggle:focus-visible { opacity: 1; }
+  #panel {
+    width: min(420px, calc(100vw - 40px)); margin-left: 8px; padding: 14px;
+    background: #262c38; border: 1px solid #3a4354; border-radius: 10px;
+    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
+  }
+  #panel[hidden] { display: none; }
+  #panel h1 { font-size: 14px; margin: 0 0 4px; }
+  #panel p { font-size: 12px; color: #9aa7ba; margin: 0 0 10px; line-height: 1.45; }
+  #clipboard {
+    width: 100%; height: 96px; resize: vertical; padding: 8px; font: inherit; font-size: 13px;
+    color: #e6ecf5; background: #1b1f27; border: 1px solid #3a4354; border-radius: 6px;
+  }
+  .row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
+  button.action {
+    font: inherit; font-size: 13px; padding: 7px 12px; cursor: pointer;
+    color: #e6ecf5; background: #343c4c; border: 1px solid #47526a; border-radius: 6px;
+  }
+  button.action:hover { background: #3e4860; }
+  button.action.primary { background: #d50032; border-color: #d50032; }
+</style>
+</head>
+<body>
+<div id="screen"></div>
+
+<div id="status">
+  <div id="status-text">Tarayıcıya bağlanılıyor…</div>
+  <div id="status-detail"></div>
+</div>
+
+<div id="bar">
+  <button id="bar-toggle" type="button" title="Pano ve görünüm" aria-label="Pano ve görünüm" aria-expanded="false"></button>
+  <div id="panel" hidden>
+    <h1>Pano</h1>
+    <p id="clipboard-hint">
+      Kopyala ve yapıştır normalde kendiliğinden çalışır. Çalışmazsa metni buraya
+      yapıştırıp <b>Tarayıcıya gönder</b>'e basın; tarayıcıda kopyaladığınız metin de burada görünür.
+    </p>
+    <textarea id="clipboard" spellcheck="false" aria-label="Pano metni"></textarea>
+    <div class="row">
+      <button id="send-clipboard" class="action primary" type="button">Tarayıcıya gönder</button>
+      <button id="fullscreen" class="action" type="button">Tam ekran</button>
+      <button id="reconnect" class="action" type="button">Yeniden bağlan</button>
+    </div>
+  </div>
+</div>
+
+<script type="module">
+import RFB from "./core/rfb.js";
+
+const screen = document.getElementById("screen");
+const statusBox = document.getElementById("status");
+const statusText = document.getElementById("status-text");
+const statusDetail = document.getElementById("status-detail");
+const panel = document.getElementById("panel");
+const toggle = document.getElementById("bar-toggle");
+const clipboardBox = document.getElementById("clipboard");
+
+// The page is served under /proxy/<workspace-id>/, so every URL is derived
+// from where the page itself was loaded.
+function socketUrl() {
+  const directory = location.pathname.replace(/[^/]*$/, "");
+  const scheme = location.protocol === "https:" ? "wss:" : "ws:";
+  return `${scheme}//${location.host}${directory}websockify`;
+}
+
+let rfb = null;
+let retryDelay = 1000;
+let retryTimer = null;
+let lastLocalClipboard = null;
+let lastRemoteClipboard = null;
+
+function showStatus(text, detail = "") {
+  statusText.textContent = text;
+  statusDetail.textContent = detail;
+  statusBox.hidden = false;
+}
+
+function connect() {
+  clearTimeout(retryTimer);
+  if (rfb) {
+    rfb.removeEventListener("disconnect", onDisconnect);
+    try { rfb.disconnect(); } catch { /* already closed */ }
+  }
+  showStatus("Tarayıcıya bağlanılıyor…");
+  rfb = new RFB(screen, socketUrl(), { shared: true });
+  rfb.resizeSession = true;   // the remote screen follows this window's size
+  rfb.scaleViewport = false;
+  rfb.qualityLevel = 7;
+  rfb.compressionLevel = 2;
+  rfb.focusOnClick = true;
+  rfb.addEventListener("connect", onConnect);
+  rfb.addEventListener("disconnect", onDisconnect);
+  rfb.addEventListener("clipboard", onRemoteClipboard);
+}
+
+function onConnect() {
+  retryDelay = 1000;
+  statusBox.hidden = true;
+  rfb.focus();
+  pushLocalClipboard();
+}
+
+function onDisconnect() {
+  showStatus(
+    "Bağlantı kesildi, yeniden bağlanılıyor…",
+    "Workspace durdurulduysa AI Factory panosundan yeniden başlatın.",
+  );
+  retryTimer = setTimeout(connect, retryDelay);
+  retryDelay = Math.min(retryDelay * 2, 15000);
+}
+
+// Remote copy -> local clipboard. Without permission the text still lands in
+// the panel, where it can be copied by hand.
+function onRemoteClipboard(event) {
+  const text = event.detail.text;
+  lastRemoteClipboard = text;
+  lastLocalClipboard = text;
+  clipboardBox.value = text;
+  if (navigator.clipboard?.writeText && document.hasFocus()) {
+    navigator.clipboard.writeText(text).catch(() => {});
+  }
+}
+
+// Local clipboard -> remote, whenever this tab gains focus: by the time the
+// user presses Ctrl+V in the remote browser the text is already there.
+async function pushLocalClipboard() {
+  if (!rfb || !navigator.clipboard?.readText || !document.hasFocus()) return;
+  let text;
+  try {
+    text = await navigator.clipboard.readText();
+  } catch {
+    return; // permission denied or unsupported: the panel is the fallback
+  }
+  if (!text || text === lastLocalClipboard) return;
+  lastLocalClipboard = text;
+  try { rfb.clipboardPasteFrom(text); } catch { /* not connected */ }
+}
+
+window.addEventListener("focus", pushLocalClipboard);
+document.addEventListener("visibilitychange", () => {
+  if (!document.hidden) pushLocalClipboard();
+});
+// Covers copying in another window without this tab ever losing focus.
+screen.addEventListener("mouseenter", pushLocalClipboard);
+
+function setPanel(open) {
+  panel.hidden = !open;
+  toggle.setAttribute("aria-expanded", String(open));
+  if (open) {
+    clipboardBox.focus();
+  } else if (rfb) {
+    rfb.focus();
+  }
+}
+toggle.addEventListener("click", () => setPanel(panel.hidden));
+document.addEventListener("keydown", (event) => {
+  if (event.key === "Escape" && !panel.hidden) setPanel(false);
+});
+
+document.getElementById("send-clipboard").addEventListener("click", () => {
+  const text = clipboardBox.value;
+  lastLocalClipboard = text;
+  try { rfb.clipboardPasteFrom(text); } catch { /* not connected */ }
+  setPanel(false);
+});
+
+// In full screen, Chromium-based browsers can hand over shortcuts such as
+// Ctrl+T and Ctrl+W, which otherwise act on the local browser.
+document.getElementById("fullscreen").addEventListener("click", async () => {
+  setPanel(false);
+  if (document.fullscreenElement) {
+    await document.exitFullscreen();
+    return;
+  }
+  try {
+    await document.documentElement.requestFullscreen();
+    await navigator.keyboard?.lock?.();
+  } catch { /* refused by the browser */ }
+});
+
+document.getElementById("reconnect").addEventListener("click", () => {
+  setPanel(false);
+  retryDelay = 1000;
+  connect();
+});
+
+connect();
+</script>
+</body>
+</html>
diff --git a/containers/browser-chromium/openbox-rc.xml b/containers/browser-chromium/openbox-rc.xml
new file mode 100644
index 0000000..a2fe389
--- /dev/null
+++ b/containers/browser-chromium/openbox-rc.xml
@@ -0,0 +1,41 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- The browser is the whole desktop: every normal window fills the screen
+     without a title bar. The window manager binds no keys, so nothing the user
+     types is swallowed before Chromium sees it; the only mouse bindings focus
+     and raise the clicked window (sign-in pop-ups, file dialogs). -->
+<openbox_config xmlns="http://openbox.org/3.4/rc">
+  <focus>
+    <focusNew>yes</focusNew>
+    <followMouse>no</followMouse>
+  </focus>
+  <placement>
+    <policy>Smart</policy>
+  </placement>
+  <desktops>
+    <number>1</number>
+  </desktops>
+  <keyboard/>
+  <mouse>
+    <context name="Client">
+      <mousebind button="Left" action="Press">
+        <action name="Focus"/>
+        <action name="Raise"/>
+      </mousebind>
+      <mousebind button="Middle" action="Press">
+        <action name="Focus"/>
+        <action name="Raise"/>
+      </mousebind>
+      <mousebind button="Right" action="Press">
+        <action name="Focus"/>
+        <action name="Raise"/>
+      </mousebind>
+    </context>
+  </mouse>
+  <applications>
+    <application type="normal">
+      <decor>no</decor>
+      <maximized>yes</maximized>
+      <focus>yes</focus>
+    </application>
+  </applications>
+</openbox_config>
