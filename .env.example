# AI Factory Platform Configuration

APP_NAME="AI Factory Çalışma Alanı Yönetimi"
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
COOKIE_SECURE=False
# Initial session lifetime; Admin > System overrides this for new logins.
ACCESS_TOKEN_EXPIRE_MINUTES=240

# Storage & Database
DATABASE_URL=sqlite+aiosqlite:///./data/aifactory.db
STORAGE_ROOT=./data/workspaces

# Quotas assigned to newly registered users (admins can override per user)
DEFAULT_USER_CPU_QUOTA=1.0
DEFAULT_USER_MEMORY_MB_QUOTA=1024
DEFAULT_USER_DISK_MB_QUOTA=10240

# Offline download publishing (admin-only updates; requires network + Podman)
DOWNLOADS_ENABLED=True
DOWNLOAD_UPDATES_ENABLED=True
DOWNLOADS_ROOT=/srv/aifactory-downloads
DOWNLOAD_BUILD_ROOT=/var/lib/aifactory/download-builds
DOWNLOAD_TARGET_PYTHON_VERSION=3.12
# Initial value; Admin HTTPS settings replace this with the certificate FQDN.
# Remote one-line worker enrollment is generated only for an active HTTPS FQDN;
# its optional route-only fallback IPv4 is stored in Admin, not in this file.
DOWNLOAD_PUBLIC_BASE_URL=http://10.253.6.189
# Temporary compatibility option. Enabling it skips worker OTA signature checks.
WORKER_OTA_ALLOW_UNSIGNED=False

# Container Orchestrator
PODMAN_BIN=podman
USE_MOCK_PODMAN=False
PODMAN_RUN_TIMEOUT_SECONDS=30

# Bootstrap fallback for generated ML model serving images. Prefer Admin >
# Integrations > Model Container Registry after installation. These credentials
# are encrypted in the controller database and sent to build workers only for
# the duration of a build. Legacy AIFACTORY_REGISTRY_* remains a 3.7.x fallback.
# MODEL_CONTAINER_REGISTRY_URL=btgvalmnxp1.tcmb.gov.tr:8599
# MODEL_CONTAINER_REGISTRY_USERNAME=service-account
# MODEL_CONTAINER_REGISTRY_PASSWORD=replace-with-registry-secret
MLFLOW_BIN=mlflow
MLFLOW_MODEL_BUILD_TIMEOUT_SECONDS=1800

# Optional all-in-one/worker fallback. Prefer the central Admin > Entegrasyonlar
# Workspace AI setting for Jupyter AI; enrolled workers fetch it automatically.
# Kilo Code is configured only in Admin (it uses each user's own AI Factory key).
# Configure the same values in /etc/aifactory/worker.env in production. The
# shared token is made available to every Jupyter workspace on that worker.
# The gateway URL is the root URL; Claude Code appends /v1/messages.
# JUPYTER_AI_GATEWAY_URL=http://llm-gateway.internal.example:5003
# JUPYTER_AI_MODEL=qwen3.6-35b
# JUPYTER_AI_GATEWAY_TOKEN=replace-with-shared-gateway-token
# JUPYTER_AI_GATEWAY_MODEL_DISCOVERY=false
# JUPYTER_AI_MODEL_CATALOG_JSON=[]
# Legacy: only affects workspaces on the retired Cline VS Code images.
# JUPYTER_AI_CLINE_ENABLED=true

# Port forwarding range
PORT_RANGE_START=10100
PORT_RANGE_END=12000

# LDAP/Active Directory is configured at runtime from the Admin panel.
# SECRET_KEY also encrypts the saved LDAP bind password; set a strong,
# persistent value before saving directory credentials.

# Initial Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Chunked transfers (configure matching limits on controller and worker)
FILE_TRANSFER_MAX_BYTES=8589934592
PROXY_MAX_REQUEST_BYTES=536870912
WORKER_MAX_TRANSFERS=32
