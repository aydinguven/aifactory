[Unit]
Description=Apply validated AI Factory Nginx ingress configuration
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/aifactory-apply-ingress
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/nginx/conf.d /etc/aifactory/tls /var/lib/aifactory/ingress /var/log/nginx /run
