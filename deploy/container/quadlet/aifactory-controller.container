[Unit]
Description=AI Factory Controller container
After=network-online.target
Wants=network-online.target
{{DATABASE_DEPENDENCIES}}

[Container]
Image={{CONTROLLER_IMAGE}}
ContainerName=aifactory-controller
Pull=never
Network=aifactory.network
EnvironmentFile=/etc/aifactory/controller.env
PublishPort=127.0.0.1:8000:8000
Volume=/var/lib/aifactory/database:/var/lib/aifactory/database:Z
Volume=/var/lib/aifactory/download-builds:/var/lib/aifactory/download-builds:Z
Volume=/var/lib/aifactory/ingress:/var/lib/aifactory/ingress:Z
Volume=/var/lib/aifactory/update-queue:/var/lib/aifactory/update-queue:Z
Volume=/srv/aifactory-downloads:/srv/aifactory-downloads:Z
Volume=/var/log/aifactory/controller:/var/log/aifactory/controller:Z
HealthCmd=python -m app.container_healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:rw,size=256m,mode=1777

[Service]
# The bind mount source must exist, including after an update rendered by an
# older installer that does not create it.
ExecStartPre=/usr/bin/install -d -o 10001 -g 10001 -m 0750 /var/log/aifactory/controller
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
