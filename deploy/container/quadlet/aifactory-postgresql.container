[Unit]
Description=AI Factory managed PostgreSQL container
After=network-online.target
Wants=network-online.target

[Container]
Image={{POSTGRES_IMAGE}}
ContainerName=aifactory-postgresql
Pull=never
Network=aifactory.network
EnvironmentFile=/etc/aifactory/postgresql.env
Volume=/var/lib/aifactory/postgresql:/var/lib/pgsql/data:Z
HealthCmd=/usr/bin/pg_isready -U aifactory -d aifactory
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

