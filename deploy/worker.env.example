AIFACTORY_CONTROLLER_URL=https://aifactory.example.com
# Optional route-only fallback. The URL, TLS SNI, Host header, and certificate
# verification continue to use the FQDN; never replace the URL with this IP.
# AIFACTORY_CONTROLLER_FALLBACK_IPV4=10.253.6.189
AIFACTORY_NODE_ID=replace-with-node-id
AIFACTORY_NODE_TOKEN=replace-with-node-token

# Optional rolling-upgrade fallback. Prefer the central Admin > Entegrasyonlar
# Jupyter AI setting; enrolled workers fetch it automatically.
# The URL must be reachable from workspace containers. The shared token is
# forwarded to every Jupyter workspace hosted by this worker.
# JUPYTER_AI_GATEWAY_URL=http://llm-gateway.internal.example:5003
# JUPYTER_AI_MODEL=qwen3.6-35b
# JUPYTER_AI_GATEWAY_TOKEN=replace-with-shared-gateway-token

# Optional mTLS configuration:
# AIFACTORY_AGENT_CA_FILE=/etc/aifactory/pki/ca.pem
# AIFACTORY_AGENT_CERT_FILE=/etc/aifactory/pki/worker.pem
# AIFACTORY_AGENT_KEY_FILE=/etc/aifactory/pki/worker-key.pem
