[Unit]
Description=Apply a queued AI Factory release
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory={{PROJECT_DIR}}
EnvironmentFile=-/etc/aifactory/controller.env
EnvironmentFile=-/etc/aifactory/worker.env
ExecStart={{PYTHON}} -m app.installer.queued_update
PrivateTmp=true
NoNewPrivileges=true
