+        <label class="form-group" style="margin:0;"><span class="form-label">Geçerlilik (gün)</span><input class="form-input" name="expires_days" type="number" min="1" max="365" value="90" required></label>
+      </div>
+      <div class="table-actions"><button class="btn btn-primary" type="submit">Token Oluştur</button><span id="mcp-token-status" class="quota-form-status" role="status" aria-live="polite"></span></div>
+    </form>
+    <div id="mcp-token-reveal" class="token-reveal" hidden>
+      <strong>Token'ınız yalnızca şimdi gösterilir; kopyalayıp güvenli bir yerde saklayın.</strong>
+      <code id="mcp-token-value"></code>
+      <p class="text-muted" style="margin:.75rem 0 0;">MCP istemci yapılandırması:</p>
+      <code id="mcp-token-config" class="mcp-config"></code>
+    </div>
+    <div class="table-container" style="margin-top:1rem;">
+      <table class="table">
+        <thead><tr><th>Ad</th><th>Yetki</th><th>Token</th><th>Son kullanım</th><th>Bitiş</th><th>İşlem</th></tr></thead>
+        <tbody id="mcp-token-rows"><tr><td colspan="6" class="text-muted">Yükleniyor…</td></tr></tbody>
+      </table>
+    </div>
+  </section>
+{% endblock %}
+
+{% block scripts %}
+<script>
+(() => {
+  const section = document.getElementById("mcp-tokens");
+  const rows = document.getElementById("mcp-token-rows");
+  const form = document.getElementById("mcp-token-form");
+  const status = document.getElementById("mcp-token-status");
+  const reveal = document.getElementById("mcp-token-reveal");
+  const esc = (value) => String(value ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
+  const when = (value) => (value ? new Date(value).toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "short" }) : "—");
+
+  async function load() {
+    const response = await fetch("/api/tokens");
+    if (!response.ok) return;
+    const tokens = await response.json();
+    document.getElementById("mcp-token-count").textContent = `${tokens.length} token`;
+    rows.innerHTML = tokens.length ? tokens.map((token) => `
+      <tr>
+        <td><strong>${esc(token.name)}</strong></td>
+        <td>${token.scope === "write" ? "Okuma ve işlem" : "Salt okunur"}</td>
+        <td><code>${esc(token.token_prefix)}…</code></td>
