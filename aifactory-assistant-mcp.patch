+        <td><button type="button" class="btn btn-danger btn-xs" data-token-delete="${token.id}" data-token-name="${esc(token.name)}">Sil</button></td>
+      </tr>`).join("") : '<tr><td colspan="6" class="text-muted">Henüz token oluşturulmadı.</td></tr>';
+  }
+
+  rows.addEventListener("click", async (event) => {
+    const button = event.target.closest("[data-token-delete]");
+    if (!button || !confirm(`"${button.dataset.tokenName}" token'ı silinsin mi? Bu token'ı kullanan istemciler bağlanamaz.`)) return;
+    await fetch(`/api/tokens/${button.dataset.tokenDelete}`, { method: "DELETE" });
+    load();
+  });
+
+  form.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    const data = new FormData(form);
+    status.textContent = "";
+    const response = await fetch("/api/tokens", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ name: data.get("name"), scope: data.get("scope"), expires_days: Number(data.get("expires_days")) }),
+    });
+    const payload = await response.json().catch(() => ({}));
+    if (!response.ok) {
+      status.textContent = typeof payload.detail === "string" ? payload.detail : "Token oluşturulamadı.";
+      return;
+    }
+    const url = `${window.location.origin}/mcp`;
+    document.getElementById("mcp-token-value").textContent = payload.token;
+    document.getElementById("mcp-token-config").textContent = JSON.stringify(
+      { mcpServers: { aifactory: { type: "streamable-http", url, headers: { Authorization: `Bearer ${payload.token}` } } } }, null, 2);
+    reveal.hidden = false;
+    form.reset();
+    load();
+  });
+
+  fetch("/api/assistant/status")
+    .then((response) => (response.ok ? response.json() : {}))
+    .then((state) => { if (state.mcp_enabled) { section.hidden = false; load(); } })
+    .catch(() => {});
+})();
+</script>
