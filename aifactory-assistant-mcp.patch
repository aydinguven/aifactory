+async def _register(client: AsyncClient, username: str) -> dict[str, str]:
+    response = await client.post(
+        "/api/auth/register",
+        json={
+            "username": username,
+            "email": f"{username}@test.com",
+            "password": "Password123!",
+            "full_name": f"{username} user",
